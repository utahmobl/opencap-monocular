# OpenCap API credentials (required)
API_TOKEN=your_opencap_api_token_here
API_URL=https://dev.opencap.ai/ or https://api.opencap.ai/ (for production)

# Internal mono-API settings
# In Docker this is overridden automatically to http://mono-api:8000/
MONO_API_URL=http://127.0.0.1:8000/
MONO_API_KEY=your_mono_api_key_here
REQUIRE_API_KEY=true
# Worker: give up on a hung /run_mono call after this many seconds (default 10m).
MONO_API_READ_TIMEOUT_SEC=600
# API: reject clips longer / denser than this before WHAM (avoids queue hangs).
MONO_MAX_VIDEO_DURATION_SEC=300
MONO_MAX_VIDEO_FRAMES=18000
MONO_TARGET_FPS=60

# Slack notifications (optional — leave blank to disable)
SLACK_WEBHOOK_URL=

# After a trial is processed and uploaded to the cloud, delete local Data/ and
# results/ copies on this machine (default: true). Set false only for debugging.
DELETE_LOCAL_AFTER_UPLOAD=true
